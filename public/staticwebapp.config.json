{
    "routes": [
        {
            "route": "/image*",
            "rewrite": "index.html"
        },
        {
            "route": "/pose*",
            "rewrite": "index.html"
        },
        {
            "route": "/speech*",
            "rewrite": "index.html"
        },
        {
            "route": "/hand*",
            "rewrite": "index.html"
        },
        {
            "route": "/deploy*",
            "rewrite": "index.html"
        },
        {
            "route": "/collect*",
            "rewrite": "index.html"
        },
        {
            "route": "/input*",
            "rewrite": "index.html"
        },
        {
            "route": "/about",
            "rewrite": "index.html"
        },
        {
            "route": "/login",
            "rewrite": "index.html"
        },
        {
            "route": "/home",
            "rewrite": "index.html"
        },
        {
            "route": "/settings",
            "rewrite": "index.html"
        }
    ],
    "globalHeaders": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer",
        "X-Frame-Options": "DENY",
        "Permissions-Policy": "camera=(self), microphone=(self), geolocation=(), payment=(), usb=(self)",
        "Content-Security-Policy": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; worker-src 'self' blob:; connect-src 'self' blob: data:; frame-src https://www.youtube.com https://player.vimeo.com;"
    }
}
