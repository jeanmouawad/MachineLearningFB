AddType application/wasm .wasm
AddType application/octet-stream .data
AddType application/octet-stream .binarypb
AddType application/octet-stream .tflite
AddType application/octet-stream .bin

<IfModule mod_mime.c>
  AddType application/wasm .wasm
  AddType application/octet-stream .data
  AddType application/octet-stream .binarypb
  AddType application/octet-stream .tflite
  AddType application/octet-stream .bin
</IfModule>

<IfModule mod_headers.c>
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=(), usb=(self)"
  Header always unset X-Powered-By
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; frame-src 'none'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; worker-src 'self' blob:; connect-src 'self' blob: data:;"
</IfModule>

<FilesMatch "\.wasm$">
  ForceType application/wasm
</FilesMatch>

<FilesMatch "^(users\.json|_lib\.php)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^api/ - [L]
  RewriteRule ^users\.json$ - [F]
  RewriteRule ^index\.html$ - [L]
  RewriteRule ^mediapipe/ - [L]
  RewriteRule ^tm-models/ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
